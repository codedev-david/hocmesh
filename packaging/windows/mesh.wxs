<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Id="MESH.Compute.Client"
    Name="MESH Compute Client"
    Manufacturer="MESH Contributors"
    Version="$(MeshVersion)"
    UpgradeCode="8A83C7C3-3369-4C5F-A907-BB5660EA6422"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer MESH Compute Client is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MESH">
        <Component Id="MeshClient" Guid="*" Bitness="always64">
          <File Id="MeshExecutable" Source="$(MeshExe)" KeyPath="yes" />
          <Environment
            Id="MeshPath"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Action="set"
            Part="last"
            System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="MESH Compute Client" Level="1">
      <ComponentRef Id="MeshClient" />
    </Feature>
  </Package>
</Wix>
