<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Id="hocMESH"
    Name="hocMESH"
    Manufacturer="hocMESH Contributors"
    Version="$(HocMeshVersion)"
    UpgradeCode="8A83C7C3-3369-4C5F-A907-BB5660EA6422"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer hocMESH is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="hocMESH">
        <!-- All three binaries ship together. Every hocMESH install is a
             whole peer: a machine that has `hocmesh` but not
             `hocmesh-coordinator` cannot start a mesh, only join one
             somebody else already started, which makes the installer a
             half-install that looks complete. -->
        <Component Id="HocMeshNode" Guid="*" Bitness="always64">
          <File Id="HocMeshExecutable" Source="$(HocMeshExe)" KeyPath="yes" />
          <Environment
            Id="HocMeshPath"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Action="set"
            Part="last"
            System="yes" />
        </Component>
        <Component Id="HocMeshCoordinator" Guid="*" Bitness="always64">
          <File Id="HocMeshCoordinatorExecutable" Source="$(HocMeshCoordinatorExe)" KeyPath="yes" />
        </Component>
        <Component Id="HocMeshValidator" Guid="*" Bitness="always64">
          <File Id="HocMeshValidatorExecutable" Source="$(HocMeshValidatorExe)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="hocMESH" Level="1">
      <ComponentRef Id="HocMeshNode" />
      <ComponentRef Id="HocMeshCoordinator" />
      <ComponentRef Id="HocMeshValidator" />
    </Feature>
  </Package>
</Wix>
