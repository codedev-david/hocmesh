{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hocMESH Desktop",
  "version": "0.5.0",
  "identifier": "org.hocmesh.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "hocMESH Desktop",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "publisher": "hocMESH Contributors",
    "copyright": "Copyright (c) 2026 hocMESH. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Share spare compute on a hocMESH network.",
    "longDescription": "hocMESH Desktop runs and supervises a hocMESH node. It shows whether the node is contributing, exactly how much of this machine is being lent, and the ledger of compute units this node has earned and spent. Nothing is bought or sold: compute units are a record of work done for other people, redeemable only for work done for you.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "provides": [
          "hocmesh"
        ],
        "conflicts": [
          "hocmesh"
        ],
        "replaces": [
          "hocmesh"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ],
        "provides": [
          "hocmesh"
        ],
        "conflicts": [
          "hocmesh"
        ],
        "obsoletes": [
          "hocmesh"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
